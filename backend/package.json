{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "download-ca": "node scripts/download-ca.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1166.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
