# Copy to backend/.env and fill in locally. npm run dev:backend loads it.
DB_HOST=your-database.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=TheBurgerLab
DB_USER=burgerlab_catalog_reader
DB_PASSWORD=
DB_SSL_CA_PATH=certs/global-bundle.pem
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
# AWS Lambda uses DB_SECRET_ARN instead of the local DB_* credentials.
# DB_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:NAME
