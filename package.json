{
  "name": "isds-fullstack-restaurant-webapp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend -- --host 0.0.0.0",
    "start": "npm run dev",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "preview": "npm run preview --workspace frontend -- --host 0.0.0.0",
    "dev:backend": "npm run dev --workspace backend",
    "build:backend": "npm run build --workspace backend",
    "package:backend": "npm run package --workspace backend",
    "test:backend": "npm test --workspace backend"
  }
}
